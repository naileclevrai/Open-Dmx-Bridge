<Application x:Class="OpenDMXBridge.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.modernwpf.com/2019">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ui:ThemeResources RequestedTheme="Light"/>
                <ui:XamlControlsResources/>
            </ResourceDictionary.MergedDictionaries>

            <FontFamily x:Key="AppFont">SF Pro Text, SF Pro, Segoe UI</FontFamily>
            <FontFamily x:Key="DisplayFont">SF Pro Display, SF Pro, Segoe UI</FontFamily>
            <FontFamily x:Key="MonoFont">SF Mono, Cascadia Mono, Consolas</FontFamily>

            <!-- Palette macOS (apparence claire) -->
            <SolidColorBrush x:Key="AccentBrush" Color="#007AFF"/>
            <SolidColorBrush x:Key="AccentPressedBrush" Color="#0062CC"/>
            <SolidColorBrush x:Key="PageBrush" Color="#ECECEC"/>
            <!-- Fond de repli si le flou système (Acrylic) est indisponible : dégradé façon fond d'écran -->
            <LinearGradientBrush x:Key="WallpaperBrush" StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#DCE7FF" Offset="0"/>
                <GradientStop Color="#F3E6FF" Offset="0.45"/>
                <GradientStop Color="#DFF6F1" Offset="1"/>
            </LinearGradientBrush>
            <SolidColorBrush x:Key="CardBrush" Color="#FFFFFF"/>
            <SolidColorBrush x:Key="CardBorderBrush" Color="#D8D8DC"/>
            <SolidColorBrush x:Key="ControlBrush" Color="#FFFFFF"/>
            <SolidColorBrush x:Key="ControlBorderBrush" Color="#C6C6CB"/>
            <SolidColorBrush x:Key="ControlHoverBrush" Color="#F5F5F7"/>
            <SolidColorBrush x:Key="ControlPressedBrush" Color="#E5E5EA"/>
            <SolidColorBrush x:Key="SegmentBrush" Color="#E3E3E8"/>
            <SolidColorBrush x:Key="SeparatorBrush" Color="#E5E5EA"/>
            <SolidColorBrush x:Key="TextPrimaryBrush" Color="#1D1D1F"/>
            <SolidColorBrush x:Key="TextSecondaryBrush" Color="#6E6E73"/>
            <SolidColorBrush x:Key="TextTertiaryBrush" Color="#AEAEB2"/>
            <SolidColorBrush x:Key="OkBrush" Color="#34C759"/>
            <SolidColorBrush x:Key="KoBrush" Color="#FF3B30"/>
            <SolidColorBrush x:Key="WarnBgBrush" Color="#FFF6E5"/>
            <SolidColorBrush x:Key="WarnBorderBrush" Color="#FFD599"/>
            <SolidColorBrush x:Key="WarnTextBrush" Color="#7A4B00"/>

            <!-- Carte façon macOS : coins 10 px, bord fin, ombre très douce -->
            <!-- Boutons façon macOS -->
            <Style x:Key="MacButton" TargetType="Button">
                <Setter Property="Background" Value="#B3FFFFFF"/>
                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                <Setter Property="BorderBrush" Value="{StaticResource GlassBorderBrush}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Padding" Value="14,0"/>
                <Setter Property="MinHeight" Value="28"/>
                <Setter Property="MinWidth" Value="26"/>
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="Cursor" Value="Arrow"/>
                <Setter Property="HorizontalContentAlignment" Value="Center"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="999" Padding="{TemplateBinding Padding}"
                                    SnapsToDevicePixels="True">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="6" ShadowDepth="1" Direction="270" Opacity="0.10" Color="#1B2B4B"/>
                                </Border.Effect>
                                <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                                  RecognizesAccessKey="True"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="#E6FFFFFF"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="#80FFFFFF"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Foreground" Value="{StaticResource TextTertiaryBrush}"/>
                                    <Setter TargetName="Bd" Property="Background" Value="#59FFFFFF"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="MacPrimaryButton" TargetType="Button" BasedOn="{StaticResource MacButton}">
                <Setter Property="Foreground" Value="White"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="BorderBrush" Value="#80FFFFFF"/>
                <Setter Property="Background">
                    <Setter.Value>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#5AAAFF" Offset="0"/>
                            <GradientStop Color="#0A84FF" Offset="1"/>
                        </LinearGradientBrush>
                    </Setter.Value>
                </Setter>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="1" CornerRadius="999" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="14" ShadowDepth="3" Direction="270" Opacity="0.35" Color="#007AFF"/>
                                </Border.Effect>
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{StaticResource AccentPressedBrush}"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="Bd" Property="Background" Value="#B9D6F7"/>
                                    <Setter TargetName="Bd" Property="BorderBrush" Value="#B9D6F7"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="MacToggleButton" TargetType="ToggleButton">
                <Setter Property="Background" Value="#B3FFFFFF"/>
                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                <Setter Property="BorderBrush" Value="{StaticResource GlassBorderBrush}"/>
                <Setter Property="MinHeight" Value="28"/>
                <Setter Property="Padding" Value="14,0"/>
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ToggleButton">
                            <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="1" CornerRadius="999" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="#E6FFFFFF"/>
                                </Trigger>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{StaticResource KoBrush}"/>
                                    <Setter TargetName="Bd" Property="BorderBrush" Value="#D92B22"/>
                                    <Setter Property="Foreground" Value="White"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Par défaut, tous les boutons prennent le style macOS -->
            <Style TargetType="Button" BasedOn="{StaticResource MacButton}"/>
            <Style TargetType="ToggleButton" BasedOn="{StaticResource MacToggleButton}"/>

            <!-- TabControl façon « segmented control » macOS -->
            <Style x:Key="MacSegment" TargetType="TabItem">
                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="Padding" Value="16,5"/>
                <Setter Property="Margin" Value="2"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="TabItem">
                            <Border x:Name="Bd" Background="Transparent" CornerRadius="999" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                                <ContentPresenter x:Name="Content" ContentSource="Header" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                  TextElement.FontWeight="Medium"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="White"/>
                                    <Setter TargetName="Content" Property="TextElement.FontWeight" Value="SemiBold"/>
                                    <Setter TargetName="Bd" Property="Effect">
                                        <Setter.Value>
                                            <DropShadowEffect BlurRadius="8" ShadowDepth="2" Direction="270" Opacity="0.18" Color="#1B2B4B"/>
                                        </Setter.Value>
                                    </Setter>
                                </Trigger>
                                <MultiTrigger>
                                    <MultiTrigger.Conditions>
                                        <Condition Property="IsMouseOver" Value="True"/>
                                        <Condition Property="IsSelected" Value="False"/>
                                    </MultiTrigger.Conditions>
                                    <Setter TargetName="Bd" Property="Background" Value="#4DFFFFFF"/>
                                </MultiTrigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="MacSegmentedControl" TargetType="TabControl">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Padding" Value="0"/>
                <Setter Property="ItemContainerStyle" Value="{StaticResource MacSegment}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="TabControl">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <Border Grid.Row="0" Background="#66FFFFFF" BorderBrush="{StaticResource GlassBorderBrush}" BorderThickness="1" CornerRadius="999" Padding="2"
                                        HorizontalAlignment="Center" Margin="0,0,0,14">
                                    <TabPanel IsItemsHost="True"/>
                                </Border>
                                <ContentPresenter Grid.Row="1" ContentSource="SelectedContent"/>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Champs : coins 6 px, bord fin, hauteur 26 comme macOS -->
            <Style TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
                <Setter Property="ui:ControlHelper.CornerRadius" Value="10"/>
                <Setter Property="Background" Value="#99FFFFFF"/>
                <Setter Property="MinHeight" Value="28"/>
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
                <Setter Property="BorderBrush" Value="{StaticResource GlassBorderBrush}"/>
            </Style>
            <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                <Setter Property="ui:ControlHelper.CornerRadius" Value="10"/>
                <Setter Property="Background" Value="#99FFFFFF"/>
                <Setter Property="MinHeight" Value="28"/>
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
                <Setter Property="BorderBrush" Value="{StaticResource GlassBorderBrush}"/>
            </Style>

            <!-- Slider façon macOS : piste fine, bouton blanc rond ombré -->
            <Style x:Key="MacSliderThumb" TargetType="Thumb">
                <Setter Property="Width" Value="22"/>
                <Setter Property="Height" Value="22"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Thumb">
                            <Grid>
                                <Ellipse x:Name="Knob" Stroke="#B3FFFFFF" StrokeThickness="1">
                                    <Ellipse.Fill>
                                        <RadialGradientBrush GradientOrigin="0.5,0.25">
                                            <GradientStop Color="#FFFFFFFF" Offset="0"/>
                                            <GradientStop Color="#F2F4F7FF" Offset="1"/>
                                        </RadialGradientBrush>
                                    </Ellipse.Fill>
                                    <Ellipse.Effect>
                                        <DropShadowEffect BlurRadius="8" ShadowDepth="2" Direction="270" Opacity="0.28" Color="#1B2B4B"/>
                                    </Ellipse.Effect>
                                </Ellipse>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Knob" Property="Effect">
                                        <Setter.Value>
                                            <DropShadowEffect BlurRadius="12" ShadowDepth="0" Opacity="0.55" Color="#0A84FF"/>
                                        </Setter.Value>
                                    </Setter>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="MacSliderRepeat" TargetType="RepeatButton">
                <Setter Property="IsTabStop" Value="False"/>
                <Setter Property="Focusable" Value="False"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="RepeatButton">
                            <Border Background="Transparent"/>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style TargetType="Slider">
                <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
                <Setter Property="Background" Value="{StaticResource GlassTrackBrush}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Slider">
                            <Grid>
                                <Border x:Name="TrackBackground" Height="5" CornerRadius="2.5" Background="{TemplateBinding Background}"
                                        VerticalAlignment="Center" Margin="8,0"/>
                                <Track x:Name="PART_Track">
                                    <Track.DecreaseRepeatButton>
                                        <RepeatButton Style="{StaticResource MacSliderRepeat}" Command="Slider.DecreaseLarge"/>
                                    </Track.DecreaseRepeatButton>
                                    <Track.IncreaseRepeatButton>
                                        <RepeatButton Style="{StaticResource MacSliderRepeat}" Command="Slider.IncreaseLarge"/>
                                    </Track.IncreaseRepeatButton>
                                    <Track.Thumb>
                                        <Thumb Style="{StaticResource MacSliderThumb}"/>
                                    </Track.Thumb>
                                </Track>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="Orientation" Value="Vertical">
                                    <Setter TargetName="TrackBackground" Property="Height" Value="Auto"/>
                                    <Setter TargetName="TrackBackground" Property="Width" Value="5"/>
                                    <Setter TargetName="TrackBackground" Property="VerticalAlignment" Value="Stretch"/>
                                    <Setter TargetName="TrackBackground" Property="HorizontalAlignment" Value="Center"/>
                                    <Setter TargetName="TrackBackground" Property="Margin" Value="0,8"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="TrackBackground" Property="Opacity" Value="0.5"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
                <Style.Triggers>
                    <Trigger Property="Orientation" Value="Vertical">
                        <Setter Property="MinWidth" Value="24"/>
                    </Trigger>
                    <Trigger Property="Orientation" Value="Horizontal">
                        <Setter Property="MinHeight" Value="24"/>
                    </Trigger>
                </Style.Triggers>
            </Style>

            <!-- Interrupteur vert macOS -->
            <SolidColorBrush x:Key="ToggleSwitchFillOn" Color="#34C759"/>
            <SolidColorBrush x:Key="ToggleSwitchFillOnPointerOver" Color="#30B953"/>
            <SolidColorBrush x:Key="ToggleSwitchFillOnPressed" Color="#2AA84A"/>
            <SolidColorBrush x:Key="ToggleSwitchStrokeOn" Color="#34C759"/>
            <SolidColorBrush x:Key="ToggleSwitchStrokeOnPointerOver" Color="#30B953"/>
            <SolidColorBrush x:Key="ToggleSwitchStrokeOnPressed" Color="#2AA84A"/>
            <SolidColorBrush x:Key="ToggleSwitchFillOff" Color="#E9E9EB"/>
            <SolidColorBrush x:Key="ToggleSwitchFillOffPointerOver" Color="#E0E0E3"/>
            <SolidColorBrush x:Key="ToggleSwitchStrokeOff" Color="#E9E9EB"/>
            <SolidColorBrush x:Key="ToggleSwitchStrokeOffPointerOver" Color="#E0E0E3"/>
            <SolidColorBrush x:Key="ToggleSwitchKnobFillOff" Color="White"/>
            <SolidColorBrush x:Key="ToggleSwitchKnobFillOffPointerOver" Color="White"/>
            <SolidColorBrush x:Key="ToggleSwitchKnobFillOn" Color="White"/>
            <SolidColorBrush x:Key="ToggleSwitchKnobFillOnPointerOver" Color="White"/>

            <!-- Verre translucide : dégradé blanc, bord lumineux, coins 22 px, ombre large et douce -->
            <LinearGradientBrush x:Key="GlassFillBrush" StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="#D9FFFFFF" Offset="0"/>
                <GradientStop Color="#A6FFFFFF" Offset="1"/>
            </LinearGradientBrush>
            <SolidColorBrush x:Key="GlassBorderBrush" Color="#B3FFFFFF"/>
            <SolidColorBrush x:Key="GlassInsetBrush" Color="#66FFFFFF"/>
            <SolidColorBrush x:Key="GlassTrackBrush" Color="#26000000"/>

            <Style x:Key="Card" TargetType="Border">
                <Setter Property="Background" Value="{StaticResource GlassFillBrush}"/>
                <Setter Property="BorderBrush" Value="{StaticResource GlassBorderBrush}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="CornerRadius" Value="22"/>
                <Setter Property="Padding" Value="18,16"/>
                <Setter Property="SnapsToDevicePixels" Value="True"/>
                <Setter Property="Effect">
                    <Setter.Value>
                        <DropShadowEffect BlurRadius="28" ShadowDepth="6" Direction="270" Opacity="0.14" Color="#1B2B4B"/>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="SectionTitle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="FontFamily" Value="{StaticResource DisplayFont}"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                <Setter Property="Margin" Value="0,0,0,10"/>
            </Style>

            <Style x:Key="FieldLabel" TargetType="TextBlock">
                <Setter Property="FontSize" Value="11"/>
                <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
                <Setter Property="Margin" Value="0,8,0,4"/>
            </Style>

            <Style x:Key="Hint" TargetType="TextBlock">
                <Setter Property="FontSize" Value="11"/>
                <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
                <Setter Property="TextWrapping" Value="Wrap"/>
                <Setter Property="Margin" Value="0,6,0,0"/>
            </Style>

            <Style x:Key="StatLabel" TargetType="TextBlock">
                <Setter Property="FontSize" Value="11"/>
                <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
            </Style>

            <Style x:Key="StatValue" TargetType="TextBlock">
                <Setter Property="FontSize" Value="22"/>
                <Setter Property="FontFamily" Value="{StaticResource DisplayFont}"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                <Setter Property="Margin" Value="0,2,0,0"/>
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>

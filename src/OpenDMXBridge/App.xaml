<Application x:Class="OpenDMXBridge.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.modernwpf.com/2019">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ui:ThemeResources RequestedTheme="Light"/>
                <ui:XamlControlsResources/>
            </ResourceDictionary.MergedDictionaries>

            <FontFamily x:Key="AppFont">SF Pro Text, SF Pro, Segoe UI</FontFamily>
            <FontFamily x:Key="DisplayFont">SF Pro Display, SF Pro, Segoe UI</FontFamily>
            <FontFamily x:Key="MonoFont">SF Mono, Cascadia Mono, Consolas</FontFamily>

            <!-- Palette macOS (apparence claire) -->
            <SolidColorBrush x:Key="AccentBrush" Color="#007AFF"/>
            <SolidColorBrush x:Key="AccentPressedBrush" Color="#0062CC"/>
            <SolidColorBrush x:Key="PageBrush" Color="#ECECEC"/>
            <SolidColorBrush x:Key="CardBrush" Color="#FFFFFF"/>
            <SolidColorBrush x:Key="CardBorderBrush" Color="#D8D8DC"/>
            <SolidColorBrush x:Key="ControlBrush" Color="#FFFFFF"/>
            <SolidColorBrush x:Key="ControlBorderBrush" Color="#C6C6CB"/>
            <SolidColorBrush x:Key="ControlHoverBrush" Color="#F5F5F7"/>
            <SolidColorBrush x:Key="ControlPressedBrush" Color="#E5E5EA"/>
            <SolidColorBrush x:Key="SegmentBrush" Color="#E3E3E8"/>
            <SolidColorBrush x:Key="SeparatorBrush" Color="#E5E5EA"/>
            <SolidColorBrush x:Key="TextPrimaryBrush" Color="#1D1D1F"/>
            <SolidColorBrush x:Key="TextSecondaryBrush" Color="#6E6E73"/>
            <SolidColorBrush x:Key="TextTertiaryBrush" Color="#AEAEB2"/>
            <SolidColorBrush x:Key="OkBrush" Color="#34C759"/>
            <SolidColorBrush x:Key="KoBrush" Color="#FF3B30"/>
            <SolidColorBrush x:Key="WarnBgBrush" Color="#FFF6E5"/>
            <SolidColorBrush x:Key="WarnBorderBrush" Color="#FFD599"/>
            <SolidColorBrush x:Key="WarnTextBrush" Color="#7A4B00"/>

            <!-- Carte façon macOS : coins 10 px, bord fin, ombre très douce -->
            <Style x:Key="Card" TargetType="Border">
                <Setter Property="Background" Value="{StaticResource CardBrush}"/>
                <Setter Property="BorderBrush" Value="{StaticResource CardBorderBrush}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="CornerRadius" Value="10"/>
                <Setter Property="Padding" Value="16,14"/>
                <Setter Property="SnapsToDevicePixels" Value="True"/>
                <Setter Property="Effect">
                    <Setter.Value>
                        <DropShadowEffect BlurRadius="10" ShadowDepth="1" Direction="270" Opacity="0.06" Color="Black"/>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="SectionTitle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="FontFamily" Value="{StaticResource DisplayFont}"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                <Setter Property="Margin" Value="0,0,0,10"/>
            </Style>

            <Style x:Key="FieldLabel" TargetType="TextBlock">
                <Setter Property="FontSize" Value="11"/>
                <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
                <Setter Property="Margin" Value="0,8,0,4"/>
            </Style>

            <Style x:Key="Hint" TargetType="TextBlock">
                <Setter Property="FontSize" Value="11"/>
                <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
                <Setter Property="TextWrapping" Value="Wrap"/>
                <Setter Property="Margin" Value="0,6,0,0"/>
            </Style>

            <Style x:Key="StatLabel" TargetType="TextBlock">
                <Setter Property="FontSize" Value="11"/>
                <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
            </Style>

            <Style x:Key="StatValue" TargetType="TextBlock">
                <Setter Property="FontSize" Value="22"/>
                <Setter Property="FontFamily" Value="{StaticResource DisplayFont}"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                <Setter Property="Margin" Value="0,2,0,0"/>
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>

<Window x:Class="OpenDMXBridge.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.modernwpf.com/2019"
        xmlns:controls="clr-namespace:OpenDMXBridge.Controls"
        xmlns:conv="clr-namespace:OpenDMXBridge.Converters"
        Title="OpenDMX Bridge"
        Height="800"
        Width="1180"
        MinHeight="640"
        MinWidth="960"
        FontFamily="{StaticResource AppFont}"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="ClearType"
        UseLayoutRounding="True"
        FontSize="13"
        Background="{DynamicResource WallpaperBrush}"
        WindowStartupLocation="CenterScreen">
    <WindowChrome.WindowChrome>
        <!-- Chrome natif : Windows dessine un seul jeu de boutons de fenêtre sur le verre -->
        <WindowChrome GlassFrameThickness="-1" CaptionHeight="34" CornerRadius="0" ResizeBorderThickness="6" UseAeroCaptionButtons="True"/>
    </WindowChrome.WindowChrome>
    <Window.Resources>
        <conv:BoolToStatusBrushConverter x:Key="StatusBrushConverter"/>
        <conv:LogLevelToBrushConverter x:Key="LogLevelBrushConverter"/>
        <conv:BridgeToggleTextConverter x:Key="BridgeToggleTextConverter"/>
        <conv:FtdiStateConverter x:Key="OutputStateConverter"/>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
    </Window.Resources>

    <Grid x:Name="RootGrid" Margin="22,38,22,22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- En-tête façon barre de titre macOS -->
        <Grid Grid.Row="0" Height="44" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Image Source="pack://application:,,,/Assets/app-256.png" Width="44" Height="44" Margin="0,0,10,0"
                       VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality">
                    <Image.Effect>
                        <DropShadowEffect BlurRadius="12" ShadowDepth="3" Direction="270" Opacity="0.28" Color="#0A84FF"/>
                    </Image.Effect>
                </Image>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="OpenDMX Bridge" FontSize="20" FontWeight="SemiBold" FontFamily="{StaticResource DisplayFont}"
                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                    <TextBlock Text="Art-Net vers Open DMX USB" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,1,0,0"/>
                </StackPanel>
                <Border Margin="16,0,0,0" VerticalAlignment="Center" CornerRadius="12" Padding="12,4"
                        Background="{DynamicResource ControlFillBrush}" BorderBrush="{DynamicResource GlassBorderBrush}" BorderThickness="1">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="8" Height="8" Margin="0,0,6,0" VerticalAlignment="Center"
                                 Fill="{Binding IsBridgeRunning, Converter={StaticResource StatusBrushConverter}}"/>
                        <TextBlock Text="{Binding StatusText}" FontSize="11" FontWeight="Medium"
                                   Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <!-- Apparence : Système → Clair → Sombre -->
                <Button Width="32" Height="32" Padding="0" Margin="0,0,12,0" FontSize="15"
                        Content="{Binding ThemeGlyph}" ToolTip="{Binding ThemeToolTip}"
                        Command="{Binding CycleThemeCommand}"/>
            <Button Style="{StaticResource MacPrimaryButton}"
                    MinWidth="128" Height="32" VerticalAlignment="Center" FontSize="13"
                    Command="{Binding ToggleBridgeCommand}"
                    Content="{Binding IsBridgeRunning, Converter={StaticResource BridgeToggleTextConverter}}"/>
            </StackPanel>
        </Grid>
        <!-- Alerte FTDI -->
        <Border Grid.Row="1"
                Background="{DynamicResource WarnBgBrush}"
                BorderBrush="{DynamicResource WarnBorderBrush}"
                BorderThickness="1" CornerRadius="16" Padding="14,10" Margin="0,0,0,14"
                Visibility="{Binding ShowFtdiWarning, Converter={StaticResource BoolToVisibilityConverter}}">
            <TextBlock Text="{Binding FtdiDriverMessage}" TextWrapping="Wrap"
                       Foreground="{DynamicResource WarnTextBrush}"/>
        </Border>

        <!-- Corps -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320" MinWidth="280"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Réglages -->
            <Border Grid.Column="0" Style="{StaticResource Card}" VerticalAlignment="Stretch">
                <StackPanel>
                    <StackPanel>
                            <TextBlock Text="Mode" Style="{StaticResource SectionTitle}"/>
                            <ComboBox HorizontalAlignment="Stretch"
                                      ItemsSource="{Binding OperationModeOptions}"
                                      SelectedItem="{Binding SelectedOperationMode}"
                                      DisplayMemberPath="Label"/>
                            <TextBlock Style="{StaticResource Hint}"
                                       Text="Monitor : analyse Art-Net sans sortie DMX."/>
                    </StackPanel>

                    <Border Style="{StaticResource Separator}"/>
                    <StackPanel>
                            <TextBlock Text="Réseau" Style="{StaticResource SectionTitle}"/>
                            <TextBlock Text="Carte réseau" Style="{StaticResource FieldLabel}"/>
                            <ComboBox HorizontalAlignment="Stretch"
                                      ItemsSource="{Binding NetworkAdapters}"
                                      SelectedItem="{Binding SelectedAdapter}"
                                      DisplayMemberPath="DisplayName"/>
                            <Button Content="Actualiser les cartes" Command="{Binding RefreshAdaptersCommand}"
                                    HorizontalAlignment="Left" Margin="0,10,0,0"/>
                            <TextBlock Text="Univers Art-Net (Net · SubNet · Universe)" Style="{StaticResource FieldLabel}"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition/><ColumnDefinition Width="8"/>
                                    <ColumnDefinition/><ColumnDefinition Width="8"/>
                                    <ColumnDefinition/>
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0" Text="{Binding ArtNetNet, UpdateSourceTrigger=PropertyChanged}"/>
                                <TextBox Grid.Column="2" Text="{Binding ArtNetSubNet, UpdateSourceTrigger=PropertyChanged}"/>
                                <TextBox Grid.Column="4" Text="{Binding ArtNetUniverse, UpdateSourceTrigger=PropertyChanged}"/>
                            </Grid>
                            <TextBlock Style="{StaticResource Hint}"
                                       Text="{Binding UniverseDisplay, StringFormat=Univers cible : {0}}"/>
                    </StackPanel>

                    <Border Style="{StaticResource Separator}"/>
                    <StackPanel IsEnabled="{Binding IsBridgeMode}">
                            <TextBlock Text="Sortie DMX" Style="{StaticResource SectionTitle}"/>
                            <TextBlock Text="Type d'interface" Style="{StaticResource FieldLabel}"/>
                            <ComboBox HorizontalAlignment="Stretch"
                                      ItemsSource="{Binding OutputTypes}"
                                      SelectedItem="{Binding SelectedOutputType}"/>
                            <TextBlock Text="Périphérique" Style="{StaticResource FieldLabel}"/>
                            <ComboBox HorizontalAlignment="Stretch"
                                      ItemsSource="{Binding OutputDevices}"
                                      SelectedItem="{Binding SelectedOutputDevice}"
                                      DisplayMemberPath="Description"/>
                            <Button Content="Détecter les interfaces" Command="{Binding RefreshOutputDevicesCommand}"
                                    HorizontalAlignment="Left" Margin="0,10,0,0"/>
                            <TextBlock Style="{StaticResource Hint}" Text="{Binding OutputInfo}"/>
                    </StackPanel>

                </StackPanel>
            </Border>

            <GridSplitter Grid.Column="1" Width="12" HorizontalAlignment="Stretch" Background="Transparent"/>

            <!-- Supervision / Journal -->
            <TabControl x:Name="MainTabs" Grid.Column="2" Style="{StaticResource MacSegmentedControl}"
                        Loaded="OnTabsLoaded" SelectionChanged="OnTabsSelectionChanged" SizeChanged="OnTabsSizeChanged">
                <TabItem Header="Supervision">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" Style="{StaticResource Card}" Margin="0,0,0,12">
                            <UniformGrid Columns="5" Rows="2">
                                <StackPanel Margin="0,0,12,14">
                                    <TextBlock Text="Art-Net" Style="{StaticResource StatLabel}"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                        <Ellipse Width="10" Height="10" Margin="0,0,6,0" VerticalAlignment="Center"
                                                 Fill="{Binding ArtNetActive, Converter={StaticResource StatusBrushConverter}}"/>
                                        <TextBlock Text="{Binding MonitorSource}" FontWeight="SemiBold" FontSize="14"
                                                   Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </StackPanel>
                                <StackPanel Margin="0,0,12,14">
                                    <TextBlock Text="FPS Art-Net" Style="{StaticResource StatLabel}"/>
                                    <TextBlock Text="{Binding ArtNetFps, StringFormat={}{0:F1}}" Style="{StaticResource StatValue}"/>
                                </StackPanel>
                                <StackPanel Margin="0,0,12,14">
                                    <TextBlock Text="FPS DMX" Style="{StaticResource StatLabel}"/>
                                    <TextBlock Text="{Binding DmxFps, StringFormat={}{0:F1}}" Style="{StaticResource StatValue}"/>
                                </StackPanel>
                                <StackPanel Margin="0,0,12,14">
                                    <TextBlock Text="Dernier paquet" Style="{StaticResource StatLabel}"/>
                                    <TextBlock Text="{Binding LastPacketDisplay}" Style="{StaticResource StatValue}"/>
                                </StackPanel>
                                <StackPanel Margin="0,0,0,14">
                                    <TextBlock Text="Sortie DMX" Style="{StaticResource StatLabel}"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                        <Ellipse Width="10" Height="10" Margin="0,0,6,0" VerticalAlignment="Center"
                                                 Fill="{Binding DmxOutputConnected, Converter={StaticResource StatusBrushConverter}}"/>
                                        <TextBlock Text="{Binding DmxOutputConnected, Converter={StaticResource OutputStateConverter}}"
                                                   FontWeight="SemiBold" FontSize="14"
                                                   Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </StackPanel>

                                <StackPanel Margin="0,0,12,0">
                                    <TextBlock Text="Paquets reçus" Style="{StaticResource StatLabel}"/>
                                    <TextBlock Text="{Binding PacketsReceived, StringFormat=N0}" Style="{StaticResource StatValue}" FontSize="16"/>
                                </StackPanel>
                                <StackPanel Margin="0,0,12,0">
                                    <TextBlock Text="Paquets envoyés" Style="{StaticResource StatLabel}"/>
                                    <TextBlock Text="{Binding PacketsSent, StringFormat=N0}" Style="{StaticResource StatValue}" FontSize="16"/>
                                </StackPanel>
                                <StackPanel Margin="0,0,12,0">
                                    <TextBlock Text="Séquences perdues" Style="{StaticResource StatLabel}"/>
                                    <TextBlock Text="{Binding LostSequences}" Style="{StaticResource StatValue}" FontSize="16"/>
                                </StackPanel>
                                <StackPanel Margin="0,0,12,0">
                                    <TextBlock Text="Hors ordre" Style="{StaticResource StatLabel}"/>
                                    <TextBlock Text="{Binding OutOfOrderPackets}" Style="{StaticResource StatValue}" FontSize="16"/>
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock Text="Paquets invalides" Style="{StaticResource StatLabel}"/>
                                    <TextBlock Text="{Binding InvalidPackets}" Style="{StaticResource StatValue}" FontSize="16"/>
                                </StackPanel>
                            </UniformGrid>
                        </Border>

                        <Border Grid.Row="1" Style="{StaticResource Card}">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Top" Text="512 canaux DMX" Style="{StaticResource SectionTitle}"/>
                                <controls:DmxChannelMonitor x:Name="ChannelMonitor" MinHeight="200"/>
                            </DockPanel>
                        </Border>
                    </Grid>
                </TabItem>
                <TabItem Header="Console">
                    <Grid DataContext="{Binding Console}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Barre de commande : même gabarit que la carte de statistiques -->
                        <Border Grid.Row="0" Style="{StaticResource Card}" Margin="0,0,0,12">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="12"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <ui:ToggleSwitch Grid.Row="0" Grid.Column="0" IsOn="{Binding IsEnabled}" OnContent="Console active"
                                                 OffContent="Console inactive" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="0,-4"/>
                                <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Content="&#x25C0;" Command="{Binding PreviousPageCommand}" Width="36" Padding="0" FontSize="10"/>
                                    <TextBlock Text="{Binding PageDisplay}" Width="120" TextAlignment="Center" VerticalAlignment="Center" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    <Button Content="&#x25B6;" Command="{Binding NextPageCommand}" Width="36" Padding="0" FontSize="10"/>
                                </StackPanel>
                                <ComboBox Grid.Row="0" Grid.Column="2" Width="236" HorizontalAlignment="Right" VerticalAlignment="Center"
                                          ItemsSource="{Binding MergeModes}"
                                          SelectedItem="{Binding SelectedMergeMode}"
                                          DisplayMemberPath="Label"/>

                                <StackPanel Grid.Row="2" Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="Grand master" Style="{StaticResource StatLabel}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                    <Slider Width="140" Minimum="0" Maximum="255" Value="{Binding Master}" VerticalAlignment="Center"
                                            PreviewMouseLeftButtonDown="OnFaderMouseDown" PreviewMouseMove="OnFaderMouseMove" PreviewMouseLeftButtonUp="OnFaderMouseUp" LostMouseCapture="OnFaderLostCapture"/>
                                    <TextBlock Text="{Binding MasterPercent}" Width="44" Margin="8,0,0,0" VerticalAlignment="Center"
                                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                                </StackPanel>
                                <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding HeldSummary}" Style="{StaticResource Hint}" Margin="0"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                <StackPanel Grid.Row="2" Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <Button Content="100 %" ToolTip="Toute la page à 100 %" Command="{Binding FullPageCommand}" Margin="0,0,8,0"/>
                                    <Button Content="Tout rendre" Command="{Binding ReleaseAllCommand}" Margin="0,0,8,0"/>
                                    <ToggleButton Content="Blackout" IsChecked="{Binding IsBlackout}" MinWidth="96"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Faders -->
                        <Border Grid.Row="1" Style="{StaticResource Card}">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Top" Text="Faders" Style="{StaticResource SectionTitle}"/>
                                <ItemsControl ItemsSource="{Binding Faders}" IsEnabled="{Binding IsEnabled}" Margin="-4,0">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <UniformGrid Rows="1"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Margin="4,0" Padding="4,12" CornerRadius="16" Background="{DynamicResource FaderCellBrush}"
                                                    BorderBrush="{DynamicResource GlassInsetBrush}" BorderThickness="1">
                                                <DockPanel>
                                                    <TextBlock DockPanel.Dock="Top" Text="{Binding Channel}" FontWeight="SemiBold" FontSize="13"
                                                               HorizontalAlignment="Center" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                                    <TextBlock DockPanel.Dock="Top" Text="{Binding LevelPercent}" Style="{StaticResource StatLabel}"
                                                               HorizontalAlignment="Center" Margin="0,2,0,8"/>
                                                    <StackPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
                                                        <Button Content="Flash" ToolTip="Canal à 100 % tant que le bouton est maintenu"
                                                                HorizontalAlignment="Stretch" Padding="0" Height="24" FontSize="11"
                                                                PreviewMouseLeftButtonDown="OnFlashDown"
                                                                PreviewMouseLeftButtonUp="OnFlashUp"
                                                                MouseLeave="OnFlashUp"/>
                                                        <Button Content="&#x00D7;" Command="{Binding ReleaseCommand}"
                                                                ToolTip="Rendre le canal au flux Art-Net"
                                                                HorizontalAlignment="Stretch" Padding="0" Height="24" FontSize="13" Margin="0,6,0,0"/>
                                                    </StackPanel>
                                                    <Slider Orientation="Vertical" Minimum="0" Maximum="255" Value="{Binding Level}"
                                                            HorizontalAlignment="Center"
                                                            PreviewMouseLeftButtonDown="OnFaderMouseDown" PreviewMouseMove="OnFaderMouseMove" PreviewMouseLeftButtonUp="OnFaderMouseUp" LostMouseCapture="OnFaderLostCapture"/>
                                                </DockPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </DockPanel>
                        </Border>
                    </Grid>
                </TabItem>
                <TabItem Header="Journal">
                    <Border Style="{StaticResource Card}">
                        <DockPanel>
                            <Grid DockPanel.Dock="Top" Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Journal" Style="{StaticResource SectionTitle}" Margin="0"/>
                                    <TextBlock Text="Messages de l'application" Style="{StaticResource Hint}" Margin="0,2,0,0"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <ComboBox Width="120" Margin="0,0,8,0"
                                              ItemsSource="{Binding LogLevelOptions}"
                                              SelectedItem="{Binding SelectedLogLevel}"
                                              DisplayMemberPath="Label"/>
                                    <Button Content="Exporter" Command="{Binding ExportLogsCommand}" Margin="0,0,8,0"/>
                                    <Button Content="Effacer" Command="{Binding ClearLogsCommand}"/>
                                </StackPanel>
                            </Grid>
                            <Border Background="{DynamicResource InsetFillBrush}" CornerRadius="14" BorderBrush="{DynamicResource GlassInsetBrush}" BorderThickness="1" Padding="6">
                                <ListBox ItemsSource="{Binding LogEntries}" Background="Transparent" BorderThickness="0"
                                         ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                         VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
                                    <ListBox.ItemContainerStyle>
                                        <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                                            <Setter Property="Padding" Value="10,2"/>
                                            <Setter Property="MinHeight" Value="0"/>
                                        </Style>
                                    </ListBox.ItemContainerStyle>
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding}" FontFamily="{StaticResource MonoFont}" FontSize="12"
                                                       Foreground="{Binding Level, Converter={StaticResource LogLevelBrushConverter}}"/>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Border>
                        </DockPanel>
                    </Border>
                </TabItem>
                <TabItem Header="Diagnostic">
                    <Border Style="{StaticResource Card}">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                                <TextBlock Text="Diagnostic" Style="{StaticResource SectionTitle}" Margin="0"/>
                                <TextBlock Text="Résumé Art-Net / DMX en temps réel" Style="{StaticResource Hint}" Margin="0,2,0,0"/>
                            </StackPanel>
                            <Border Background="{DynamicResource InsetFillBrush}" CornerRadius="14" BorderBrush="{DynamicResource GlassInsetBrush}" BorderThickness="1" Padding="16,14"
                                    VerticalAlignment="Top">
                                <TextBlock Text="{Binding MonitorSummary}" FontFamily="{StaticResource MonoFont}" FontSize="12" LineHeight="20"
                                           Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap"/>
                            </Border>
                        </DockPanel>
                    </Border>
                </TabItem>
            </TabControl>
        </Grid>

    </Grid>
</Window>

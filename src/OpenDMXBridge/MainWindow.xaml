<Window x:Class="OpenDMXBridge.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.modernwpf.com/2019"
        xmlns:controls="clr-namespace:OpenDMXBridge.Controls"
        xmlns:conv="clr-namespace:OpenDMXBridge.Converters"
        ui:WindowHelper.UseModernWindowStyle="True"
        ui:TitleBar.Background="{StaticResource PageBrush}"
        ui:TitleBar.InactiveBackground="{StaticResource PageBrush}"
        ui:TitleBar.Foreground="{StaticResource TextSecondaryBrush}"
        Title="OpenDMX Bridge"
        Height="800"
        Width="1180"
        MinHeight="640"
        MinWidth="960"
        FontFamily="{StaticResource AppFont}"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="ClearType"
        UseLayoutRounding="True"
        FontSize="13"
        Background="{StaticResource PageBrush}"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <conv:BoolToStatusBrushConverter x:Key="StatusBrushConverter"/>
        <conv:LogLevelToBrushConverter x:Key="LogLevelBrushConverter"/>
        <conv:BridgeToggleTextConverter x:Key="BridgeToggleTextConverter"/>
        <conv:FtdiStateConverter x:Key="OutputStateConverter"/>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- En-tête façon barre de titre macOS -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Border Width="34" Height="34" CornerRadius="9" Margin="0,0,12,0" VerticalAlignment="Center">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#5AC8FA" Offset="0"/>
                            <GradientStop Color="#007AFF" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="6" ShadowDepth="1" Direction="270" Opacity="0.2" Color="#004A99"/>
                    </Border.Effect>
                    <TextBlock Text="DMX" FontFamily="{StaticResource DisplayFont}" FontWeight="Bold" FontSize="11"
                               Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="OpenDMX Bridge" FontSize="20" FontWeight="SemiBold" FontFamily="{StaticResource DisplayFont}"
                               Foreground="{StaticResource TextPrimaryBrush}"/>
                    <TextBlock Text="Art-Net vers Open DMX USB" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,1,0,0"/>
                </StackPanel>
                <Border Margin="16,0,0,0" VerticalAlignment="Center" CornerRadius="11" Padding="10,3"
                        Background="White" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="8" Height="8" Margin="0,0,6,0" VerticalAlignment="Center"
                                 Fill="{Binding IsBridgeRunning, Converter={StaticResource StatusBrushConverter}}"/>
                        <TextBlock Text="{Binding StatusText}" FontSize="11" FontWeight="Medium"
                                   Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </StackPanel>
            <Button Grid.Column="1" Style="{StaticResource MacPrimaryButton}"
                    MinWidth="120" Height="30" VerticalAlignment="Center"
                    Command="{Binding ToggleBridgeCommand}"
                    Content="{Binding IsBridgeRunning, Converter={StaticResource BridgeToggleTextConverter}}"/>
        </Grid>
        <!-- Alerte FTDI -->
        <Border Grid.Row="1"
                Background="{StaticResource WarnBgBrush}"
                BorderBrush="{StaticResource WarnBorderBrush}"
                BorderThickness="1" CornerRadius="6" Padding="12,8" Margin="0,0,0,12"
                Visibility="{Binding ShowFtdiWarning, Converter={StaticResource BoolToVisibilityConverter}}">
            <TextBlock Text="{Binding FtdiDriverMessage}" TextWrapping="Wrap"
                       Foreground="{StaticResource WarnTextBrush}"/>
        </Border>

        <!-- Corps -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320" MinWidth="280"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Réglages -->
            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" Padding="0,0,4,0">
                <StackPanel>
                    <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="Mode" Style="{StaticResource SectionTitle}"/>
                            <ComboBox HorizontalAlignment="Stretch"
                                      ItemsSource="{Binding OperationModeOptions}"
                                      SelectedItem="{Binding SelectedOperationMode}"
                                      DisplayMemberPath="Label"/>
                            <TextBlock Style="{StaticResource Hint}"
                                       Text="Monitor : analyse Art-Net sans sortie DMX."/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="Réseau" Style="{StaticResource SectionTitle}"/>
                            <TextBlock Text="Carte réseau" Style="{StaticResource FieldLabel}" Margin="0,0,0,4"/>
                            <ComboBox HorizontalAlignment="Stretch"
                                      ItemsSource="{Binding NetworkAdapters}"
                                      SelectedItem="{Binding SelectedAdapter}"
                                      DisplayMemberPath="DisplayName"/>
                            <Button Content="Actualiser les cartes" Command="{Binding RefreshAdaptersCommand}"
                                    HorizontalAlignment="Left" Margin="0,8,0,0"/>
                            <TextBlock Text="Univers Art-Net (Net · SubNet · Universe)" Style="{StaticResource FieldLabel}"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition/><ColumnDefinition Width="8"/>
                                    <ColumnDefinition/><ColumnDefinition Width="8"/>
                                    <ColumnDefinition/>
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0" Text="{Binding ArtNetNet, UpdateSourceTrigger=PropertyChanged}"/>
                                <TextBox Grid.Column="2" Text="{Binding ArtNetSubNet, UpdateSourceTrigger=PropertyChanged}"/>
                                <TextBox Grid.Column="4" Text="{Binding ArtNetUniverse, UpdateSourceTrigger=PropertyChanged}"/>
                            </Grid>
                            <TextBlock Style="{StaticResource Hint}"
                                       Text="{Binding UniverseDisplay, StringFormat=Univers cible : {0}}"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" IsEnabled="{Binding IsBridgeMode}">
                        <StackPanel>
                            <TextBlock Text="Sortie DMX" Style="{StaticResource SectionTitle}"/>
                            <TextBlock Text="Type d'interface" Style="{StaticResource FieldLabel}" Margin="0,0,0,4"/>
                            <ComboBox HorizontalAlignment="Stretch"
                                      ItemsSource="{Binding OutputTypes}"
                                      SelectedItem="{Binding SelectedOutputType}"/>
                            <TextBlock Text="Périphérique" Style="{StaticResource FieldLabel}"/>
                            <ComboBox HorizontalAlignment="Stretch"
                                      ItemsSource="{Binding OutputDevices}"
                                      SelectedItem="{Binding SelectedOutputDevice}"
                                      DisplayMemberPath="Description"/>
                            <Button Content="Détecter les interfaces" Command="{Binding RefreshOutputDevicesCommand}"
                                    HorizontalAlignment="Left" Margin="0,8,0,0"/>
                            <TextBlock Style="{StaticResource Hint}" Text="{Binding OutputInfo}"/>
                        </StackPanel>
                    </Border>

                </StackPanel>
            </ScrollViewer>

            <GridSplitter Grid.Column="1" Width="12" HorizontalAlignment="Stretch" Background="Transparent"/>

            <!-- Supervision / Journal -->
            <TabControl Grid.Column="2" Style="{StaticResource MacSegmentedControl}">
                <TabItem Header="Supervision">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" Style="{StaticResource Card}" Margin="0,0,0,12">
                            <UniformGrid Columns="5" Rows="2">
                                <StackPanel Margin="0,0,12,12">
                                    <TextBlock Text="Art-Net" Style="{StaticResource StatLabel}"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                        <Ellipse Width="10" Height="10" Margin="0,0,6,0" VerticalAlignment="Center"
                                                 Fill="{Binding ArtNetActive, Converter={StaticResource StatusBrushConverter}}"/>
                                        <TextBlock Text="{Binding MonitorSource}" FontWeight="SemiBold" FontSize="14"
                                                   Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </StackPanel>
                                <StackPanel Margin="0,0,12,12">
                                    <TextBlock Text="FPS Art-Net" Style="{StaticResource StatLabel}"/>
                                    <TextBlock Text="{Binding ArtNetFps, StringFormat={}{0:F1}}" Style="{StaticResource StatValue}"/>
                                </StackPanel>
                                <StackPanel Margin="0,0,12,12">
                                    <TextBlock Text="FPS DMX" Style="{StaticResource StatLabel}"/>
                                    <TextBlock Text="{Binding DmxFps, StringFormat={}{0:F1}}" Style="{StaticResource StatValue}"/>
                                </StackPanel>
                                <StackPanel Margin="0,0,12,12">
                                    <TextBlock Text="Dernier paquet" Style="{StaticResource StatLabel}"/>
                                    <TextBlock Text="{Binding LastPacketDisplay}" Style="{StaticResource StatValue}"/>
                                </StackPanel>
                                <StackPanel Margin="0,0,0,12">
                                    <TextBlock Text="Sortie DMX" Style="{StaticResource StatLabel}"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                        <Ellipse Width="10" Height="10" Margin="0,0,6,0" VerticalAlignment="Center"
                                                 Fill="{Binding DmxOutputConnected, Converter={StaticResource StatusBrushConverter}}"/>
                                        <TextBlock Text="{Binding DmxOutputConnected, Converter={StaticResource OutputStateConverter}}"
                                                   FontWeight="SemiBold" FontSize="14"
                                                   Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </StackPanel>

                                <StackPanel Margin="0,0,12,0">
                                    <TextBlock Text="Paquets reçus" Style="{StaticResource StatLabel}"/>
                                    <TextBlock Text="{Binding PacketsReceived, StringFormat=N0}" Style="{StaticResource StatValue}" FontSize="16"/>
                                </StackPanel>
                                <StackPanel Margin="0,0,12,0">
                                    <TextBlock Text="Paquets envoyés" Style="{StaticResource StatLabel}"/>
                                    <TextBlock Text="{Binding PacketsSent, StringFormat=N0}" Style="{StaticResource StatValue}" FontSize="16"/>
                                </StackPanel>
                                <StackPanel Margin="0,0,12,0">
                                    <TextBlock Text="Séquences perdues" Style="{StaticResource StatLabel}"/>
                                    <TextBlock Text="{Binding LostSequences}" Style="{StaticResource StatValue}" FontSize="16"/>
                                </StackPanel>
                                <StackPanel Margin="0,0,12,0">
                                    <TextBlock Text="Hors ordre" Style="{StaticResource StatLabel}"/>
                                    <TextBlock Text="{Binding OutOfOrderPackets}" Style="{StaticResource StatValue}" FontSize="16"/>
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock Text="Paquets invalides" Style="{StaticResource StatLabel}"/>
                                    <TextBlock Text="{Binding InvalidPackets}" Style="{StaticResource StatValue}" FontSize="16"/>
                                </StackPanel>
                            </UniformGrid>
                        </Border>

                        <Border Grid.Row="1" Style="{StaticResource Card}">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Top" Text="512 canaux DMX" Style="{StaticResource SectionTitle}"/>
                                <controls:DmxChannelMonitor x:Name="ChannelMonitor" MinHeight="200"/>
                            </DockPanel>
                        </Border>
                    </Grid>
                </TabItem>
                <TabItem Header="Console">
                    <Border Style="{StaticResource Card}" DataContext="{Binding Console}">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <ui:ToggleSwitch IsOn="{Binding IsEnabled}" OnContent="Console active"
                                                     OffContent="Console inactive" VerticalAlignment="Center"/>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Button Content="&#x25C0;" Command="{Binding PreviousPageCommand}" MinWidth="40" FontSize="11"/>
                                        <TextBlock Text="{Binding PageDisplay}" Margin="12,0" VerticalAlignment="Center" FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextPrimaryBrush}"/>
                                        <Button Content="&#x25B6;" Command="{Binding NextPageCommand}" MinWidth="40" FontSize="11"/>
                                    </StackPanel>
                                    <ComboBox Grid.Column="2" Width="240" VerticalAlignment="Center"
                                              ItemsSource="{Binding MergeModes}"
                                              SelectedItem="{Binding SelectedMergeMode}"
                                              DisplayMemberPath="Label"/>
                                </Grid>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="Grand master" Style="{StaticResource StatLabel}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                        <Slider Width="180" Minimum="0" Maximum="255" Value="{Binding Master}" VerticalAlignment="Center"
                                                PreviewMouseLeftButtonDown="OnFaderMouseDown" PreviewMouseMove="OnFaderMouseMove" PreviewMouseLeftButtonUp="OnFaderMouseUp" LostMouseCapture="OnFaderLostCapture"/>
                                        <TextBlock Text="{Binding MasterPercent}" Width="48" Margin="10,0,0,0" VerticalAlignment="Center"
                                                   Foreground="{StaticResource TextPrimaryBrush}"/>
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" Text="{Binding HeldSummary}" Style="{StaticResource Hint}" Margin="16,0"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button Content="Page à 100 %" Command="{Binding FullPageCommand}" Margin="0,0,8,0"/>
                                        <Button Content="Tout rendre" Command="{Binding ReleaseAllCommand}" Margin="0,0,8,0"/>
                                        <ToggleButton Content="Blackout" IsChecked="{Binding IsBlackout}" MinWidth="96"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>

                            <ItemsControl ItemsSource="{Binding Faders}" IsEnabled="{Binding IsEnabled}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Rows="1"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Margin="3,0" Padding="4,8" CornerRadius="8" Background="#F7F7F9"
                                                BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1">
                                            <DockPanel>
                                                <TextBlock DockPanel.Dock="Top" Text="{Binding Channel}" FontWeight="SemiBold"
                                                           HorizontalAlignment="Center" Foreground="{StaticResource TextPrimaryBrush}"/>
                                                <TextBlock DockPanel.Dock="Top" Text="{Binding LevelPercent}" Style="{StaticResource StatLabel}"
                                                           HorizontalAlignment="Center" Margin="0,2,0,6"/>
                                                <StackPanel DockPanel.Dock="Bottom" Margin="0,6,0,0">
                                                    <Button Content="Flash" ToolTip="Canal à 100 % tant que le bouton est maintenu"
                                                            HorizontalAlignment="Stretch" Padding="0,3" FontSize="11"
                                                            PreviewMouseLeftButtonDown="OnFlashDown"
                                                            PreviewMouseLeftButtonUp="OnFlashUp"
                                                            MouseLeave="OnFlashUp"/>
                                                    <Button Content="&#x00D7;" Command="{Binding ReleaseCommand}"
                                                            ToolTip="Rendre le canal au flux Art-Net"
                                                            HorizontalAlignment="Stretch" Padding="0,2" FontSize="13" Margin="0,4,0,0"/>
                                                </StackPanel>
                                                <Slider Orientation="Vertical" Minimum="0" Maximum="255" Value="{Binding Level}"
                                                        HorizontalAlignment="Center"
                                                        PreviewMouseLeftButtonDown="OnFaderMouseDown" PreviewMouseMove="OnFaderMouseMove" PreviewMouseLeftButtonUp="OnFaderMouseUp" LostMouseCapture="OnFaderLostCapture"/>
                                            </DockPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </DockPanel>
                    </Border>
                </TabItem>
                <TabItem Header="Journal">
                    <Border Style="{StaticResource Card}" Padding="16,12">
                        <DockPanel>
                                        <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Messages de l'application" Style="{StaticResource Hint}" Margin="0" VerticalAlignment="Center"/>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                                <ComboBox Width="120" Margin="0,0,8,0"
                                                          ItemsSource="{Binding LogLevelOptions}"
                                                          SelectedItem="{Binding SelectedLogLevel}"
                                                          DisplayMemberPath="Label"/>
                                                <Button Content="Exporter" Command="{Binding ExportLogsCommand}" Margin="0,0,8,0"/>
                                                <Button Content="Effacer" Command="{Binding ClearLogsCommand}"/>
                                            </StackPanel>
                                        </Grid>
                                        <ListBox ItemsSource="{Binding LogEntries}" Background="#FAFAFC" ui:ControlHelper.CornerRadius="8"
                                                 BorderThickness="1" BorderBrush="{StaticResource CardBorderBrush}"
                                                 ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                                 VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
                                            <ListBox.ItemContainerStyle>
                                                <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                                                    <Setter Property="Padding" Value="8,1"/>
                                                    <Setter Property="MinHeight" Value="0"/>
                                                </Style>
                                            </ListBox.ItemContainerStyle>
                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding}" FontFamily="{StaticResource MonoFont}" FontSize="12"
                                                               Foreground="{Binding Level, Converter={StaticResource LogLevelBrushConverter}}"/>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                    </DockPanel>
                    </Border>
                </TabItem>
                <TabItem Header="Diagnostic">
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Résumé Art-Net / DMX" Style="{StaticResource SectionTitle}"/>
                            <TextBlock Text="{Binding MonitorSummary}" FontFamily="{StaticResource MonoFont}" FontSize="12"
                                       Foreground="{StaticResource TextPrimaryBrush}" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                </TabItem>
            </TabControl>
        </Grid>

    </Grid>
</Window>

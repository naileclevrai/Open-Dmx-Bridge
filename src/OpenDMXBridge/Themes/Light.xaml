<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ====================================================================
         Thème CLAIR — palette macOS / Liquid Glass
         Toutes les couleurs de l'application vivent ici (et dans Dark.xaml).
         Les styles y font référence en DynamicResource pour permettre le
         basculement à chaud.
         ==================================================================== -->

    <!-- Accent et états -->
    <SolidColorBrush x:Key="AccentBrush" Color="#007AFF"/>
    <SolidColorBrush x:Key="AccentPressedBrush" Color="#0062CC"/>
    <SolidColorBrush x:Key="OkBrush" Color="#34C759"/>
    <SolidColorBrush x:Key="KoBrush" Color="#FF3B30"/>
    <SolidColorBrush x:Key="KoBorderBrush" Color="#D92B22"/>

    <!-- Fond de repli si le flou système (Acrylic) est indisponible -->
    <LinearGradientBrush x:Key="WallpaperBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#DCE7FF" Offset="0"/>
        <GradientStop Color="#F3E6FF" Offset="0.45"/>
        <GradientStop Color="#DFF6F1" Offset="1"/>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="PageBrush" Color="#ECECEC"/>

    <!-- Textes -->
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#1D1D1F"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#6E6E73"/>
    <SolidColorBrush x:Key="TextTertiaryBrush" Color="#AEAEB2"/>
    <SolidColorBrush x:Key="TextOnAccentBrush" Color="#FFFFFF"/>

    <!-- Verre : cartes -->
    <LinearGradientBrush x:Key="GlassFillBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#D9FFFFFF" Offset="0"/>
        <GradientStop Color="#A6FFFFFF" Offset="1"/>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="GlassBorderBrush" Color="#B3FFFFFF"/>
    <SolidColorBrush x:Key="GlassInsetBrush" Color="#66FFFFFF"/>
    <SolidColorBrush x:Key="GlassTrackBrush" Color="#26000000"/>
    <SolidColorBrush x:Key="InsetFillBrush" Color="#80FFFFFF"/>
    <SolidColorBrush x:Key="FaderCellBrush" Color="#66FFFFFF"/>
    <SolidColorBrush x:Key="SeparatorLineBrush" Color="#1F1B2B4B"/>

    <!-- Boutons -->
    <SolidColorBrush x:Key="ControlFillBrush" Color="#B3FFFFFF"/>
    <SolidColorBrush x:Key="ControlHoverFillBrush" Color="#E6FFFFFF"/>
    <SolidColorBrush x:Key="ControlPressedFillBrush" Color="#80FFFFFF"/>
    <SolidColorBrush x:Key="ControlDisabledFillBrush" Color="#59FFFFFF"/>
    <LinearGradientBrush x:Key="PrimaryFillBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#5AAAFF" Offset="0"/>
        <GradientStop Color="#0A84FF" Offset="1"/>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="PrimaryBorderBrush" Color="#80FFFFFF"/>
    <SolidColorBrush x:Key="PrimaryDisabledBrush" Color="#B9D6F7"/>

    <!-- Champs et menus -->
    <SolidColorBrush x:Key="FieldFillBrush" Color="#A6FFFFFF"/>
    <SolidColorBrush x:Key="FieldHoverFillBrush" Color="#D9FFFFFF"/>
    <SolidColorBrush x:Key="FieldFocusFillBrush" Color="#F2FFFFFF"/>
    <SolidColorBrush x:Key="PopupFillBrush" Color="#F5FFFFFF"/>
    <SolidColorBrush x:Key="TextSelectionBrush" Color="#660A84FF"/>

    <!-- Sélecteur segmenté -->
    <SolidColorBrush x:Key="SegmentTrackBrush" Color="#1A1B2B4B"/>
    <SolidColorBrush x:Key="SegmentHoverBrush" Color="#66FFFFFF"/>
    <SolidColorBrush x:Key="IndicatorFillBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="IndicatorBorderBrush" Color="#33000000"/>

    <!-- Sliders -->
    <RadialGradientBrush x:Key="KnobFillBrush" GradientOrigin="0.5,0.25">
        <GradientStop Color="#FFFFFFFF" Offset="0"/>
        <GradientStop Color="#F2F4F7FF" Offset="1"/>
    </RadialGradientBrush>
    <SolidColorBrush x:Key="KnobStrokeBrush" Color="#B3FFFFFF"/>

    <!-- Alerte -->
    <SolidColorBrush x:Key="WarnBgBrush" Color="#CCFFF1D6"/>
    <SolidColorBrush x:Key="WarnBorderBrush" Color="#B3FFFFFF"/>
    <SolidColorBrush x:Key="WarnTextBrush" Color="#7A4B00"/>

    <!-- Interrupteur (clés ModernWpf) -->
    <SolidColorBrush x:Key="ToggleSwitchFillOn" Color="#34C759"/>
    <SolidColorBrush x:Key="ToggleSwitchFillOnPointerOver" Color="#30B953"/>
    <SolidColorBrush x:Key="ToggleSwitchFillOnPressed" Color="#2AA84A"/>
    <SolidColorBrush x:Key="ToggleSwitchStrokeOn" Color="#34C759"/>
    <SolidColorBrush x:Key="ToggleSwitchStrokeOnPointerOver" Color="#30B953"/>
    <SolidColorBrush x:Key="ToggleSwitchStrokeOnPressed" Color="#2AA84A"/>
    <SolidColorBrush x:Key="ToggleSwitchFillOff" Color="#331B2B4B"/>
    <SolidColorBrush x:Key="ToggleSwitchFillOffPointerOver" Color="#401B2B4B"/>
    <SolidColorBrush x:Key="ToggleSwitchStrokeOff" Color="#40FFFFFF"/>
    <SolidColorBrush x:Key="ToggleSwitchStrokeOffPointerOver" Color="#40FFFFFF"/>
    <SolidColorBrush x:Key="ToggleSwitchKnobFillOff" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="ToggleSwitchKnobFillOffPointerOver" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="ToggleSwitchKnobFillOn" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="ToggleSwitchKnobFillOnPointerOver" Color="#FFFFFF"/>

    <!-- Moniteur 512 canaux et journal (lus depuis le code) -->
    <Color x:Key="MonitorCellColor">#2E1B2B4B</Color>
    <Color x:Key="MonitorBarLowColor">#0A84FF</Color>
    <Color x:Key="MonitorBarHighColor">#3AC4FF</Color>
    <Color x:Key="LogInfoColor">#1D1D1F</Color>
    <Color x:Key="LogDebugColor">#7A7A7A</Color>
    <Color x:Key="LogTraceColor">#9A9A9A</Color>
    <Color x:Key="LogWarningColor">#B25E00</Color>
    <Color x:Key="LogErrorColor">#FF3B30</Color>
</ResourceDictionary>
